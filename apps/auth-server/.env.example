# Public origin of this auth server. Lark callback must be exactly:
# ${AUTH_BASE_URL}/api/auth/lark/callback
AUTH_BASE_URL=http://localhost:3000

# Neon/Vercel Postgres pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace-me
LARK_ALLOWED_TENANT_KEY=replace-with-the-single-allowed-tenant-key
LARK_DOMAIN=https://open.larksuite.com
# Lark Mail mailbox identity used by the server-side mail adapter.
LARK_PO_APPROVER_EMAIL=approver@example.com

# ERP application card shown in Letron Global Portal.
LETRON_SSO_ERP_BASE_URL=http://localhost:8080
LETRON_NEXT_BASE_URL=http://localhost:3001
LETRON_SUPPLIER_PORTAL_PUBLIC_BASE_URL=http://localhost:3001
# Same group_id -> ERP role mapping used by ERP. It also controls which portal
# application and feature labels are visible; it is not an authorization boundary.
LETRON_SSO_LARK_ROLE_MAPPING={"replace-erp-access-group-id":["Desk User"]}

# Optional API-only test credential. The key is bound to the existing
# LARK_PO_APPROVER_EMAIL Lark user.
LETRON_API_KEY=replace-with-at-least-32-character-test-key

# Shared only with the ERP runtime for the reconciliation endpoint.
LETRON_SSO_SYNC_SECRET=change-me-at-least-32-characters

# Generate the three values below with: npm run keys:generate
AUTH_DATA_ENCRYPTION_KEY=base64-32-byte-key
OIDC_COOKIE_KEYS=["newest-random-cookie-key","previous-random-cookie-key"]
OIDC_JWKS={"keys":[{"kty":"RSA","kid":"replace-me"}]}


# Required shared cache for Vercel production.
KV_REST_API_URL=https://example.upstash.io
KV_REST_API_TOKEN=replace-me
