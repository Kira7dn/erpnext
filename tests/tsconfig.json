{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["../apps/erp/src/*"]
    },
    "types": ["node"],
    "typeRoots": ["../apps/auth-server/node_modules/@types"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "../apps/erpnext",
    "../apps/lark-bot-official",
    "../apps/lark-bot",
    "../node_modules"
  ]
}
