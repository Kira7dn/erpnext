    "section_break_jkdf": {
      "type": [
        "string",
        "null"
      ]
    },
    "column_break_sigk": {
      "type": [
        "string",
        "null"
      ]
    },
    "increase_in_asset_life": {
      "type": [
        "integer",
        "null"
      ],
      "readOnly": true
    }
