{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/ModeofPayment.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode_of_payment": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Cash",
        "Bank",
        "General",
        "Phone"
      ]
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "ModeofPaymentAccount.json"
      }
    },
    "enabled": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "mode_of_payment",
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Accounts"
}