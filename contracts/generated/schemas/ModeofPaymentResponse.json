{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/ModeofPaymentResponse.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode_of_payment": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Cash",
        "Bank",
        "General",
        "Phone",
        "",
        null
      ]
    },
    "accounts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "ModeofPaymentAccountResponse.json"
      }
    },
    "enabled": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Accounts"
}