{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/LandedCostVoucher.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "naming_series": {
      "type": "string",
      "enum": [
        "MAT-LCV-.YYYY.-"
      ]
    },
    "company": {
      "type": "string",
      "x-frappe-target-doctype": "Company"
    },
    "purchase_receipts": {
      "type": "array",
      "items": {
        "$ref": "LandedCostPurchaseReceipt.json"
      }
    },
    "purchase_receipt_items": {
      "type": "string"
    },
    "get_items_from_purchase_receipts": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "LandedCostItem.json"
      }
    },
    "sec_break1": {
      "type": "string"
    },
    "taxes": {
      "type": "array",
      "items": {
        "$ref": "LandedCostTaxesandCharges.json"
      }
    },
    "section_break_9": {
      "type": "string"
    },
    "total_taxes_and_charges": {
      "type": "number",
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true
    },
    "col_break1": {
      "type": "string"
    },
    "distribute_charges_based_on": {
      "type": "string",
      "enum": [
        "Qty",
        "Amount",
        "Distribute Manually"
      ]
    },
    "amended_from": {
      "type": "string",
      "x-frappe-target-doctype": "Landed Cost Voucher",
      "readOnly": true
    },
    "sec_break2": {
      "type": "string"
    },
    "landed_cost_help": {
      "type": "string"
    },
    "column_break_2": {
      "type": "string"
    },
    "posting_date": {
      "type": "string",
      "format": "date"
    },
    "section_break_5": {
      "type": "string"
    },
    "vendor_invoices": {
      "type": "array",
      "items": {
        "$ref": "LandedCostVendorInvoice.json"
      }
    },
    "total_vendor_invoices_cost": {
      "type": "number",
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true
    }
  },
  "required": [
    "company",
    "distribute_charges_based_on",
    "items",
    "name",
    "naming_series",
    "posting_date",
    "purchase_receipts",
    "taxes",
    "total_taxes_and_charges"
  ],
  "additionalProperties": true,
  "x-module": "Stock"
}