{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/PricingRuleDetailResponse.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "pricing_rule": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Pricing Rule",
      "readOnly": true
    },
    "item_code": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true
    },
    "margin_type": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "writeOnly": true
    },
    "rate_or_discount": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "writeOnly": true
    },
    "child_docname": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "writeOnly": true
    },
    "rule_applied": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1,
          "readOnly": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Accounts"
}