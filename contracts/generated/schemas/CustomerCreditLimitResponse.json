{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/CustomerCreditLimitResponse.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "credit_limit": {
      "type": [
        "number",
        "null"
      ]
    },
    "overdue_billing_threshold": {
      "type": [
        "number",
        "null"
      ],
      "writeOnly": true
    },
    "column_break_2": {
      "type": [
        "string",
        "null"
      ]
    },
    "company": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Company"
    },
    "bypass_credit_limit_check": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Selling"
}