    "max_amount": {
      "type": "number"
    },
    "column_break_zcez": {
      "type": "string"
    },
    "rule_description": {
      "type": "string"
    },
    "section_break_licn": {
      "type": "string"
    },
    "description_rules": {
      "type": "array",
      "items": {
