{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/AssetMaintenanceTaskWrite.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "maintenance_task": {
      "type": "string"
    },
    "maintenance_type": {
      "type": "string",
      "enum": [
        "Preventive Maintenance",
        "Calibration"
      ]
    },
    "column_break_2": {
      "type": "string"
    },
    "maintenance_status": {
      "type": "string",
      "enum": [
        "Planned",
        "Overdue",
        "Cancelled"
      ]
    },
    "section_break_2": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "periodicity": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Monthly",
        "Quarterly",
        "Half-yearly",
        "Yearly",
        "2 Yearly",
        "3 Yearly"
      ]
    },
    "column_break_4": {
      "type": "string"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "certificate_required": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "section_break_9": {
      "type": "string"
    },
    "assign_to": {
      "type": "string",
      "x-frappe-target-doctype": "User"
    },
    "column_break_10": {
      "type": "string"
    },
    "assign_to_name": {
      "type": "string"
    },
    "section_break_10": {
      "type": "string"
    },
    "next_due_date": {
      "type": "string",
      "format": "date"
    },
    "column_break_14": {
      "type": "string"
    },
    "last_completion_date": {
      "type": "string",
      "format": "date"
    },
    "section_break_7": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "custom_letron_orchestration_id": {
      "type": "string"
    },
    "custom_lark_approval_status": {
      "type": "string"
    }
  },
  "required": [
    "maintenance_status",
    "maintenance_task",
    "periodicity",
    "start_date"
  ],
  "additionalProperties": false,
  "x-module": "Assets"
}