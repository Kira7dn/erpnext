{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/LandedCostTaxesandChargesResponse.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "col_break3": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": [
        "number",
        "null"
      ],
      "x-frappe-options": "account_currency"
    },
    "expense_account": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Account"
    },
    "account_currency": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Currency",
      "readOnly": true
    },
    "exchange_rate": {
      "type": [
        "number",
        "null"
      ]
    },
    "base_amount": {
      "type": [
        "number",
        "null"
      ],
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true
    },
    "has_corrective_cost": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1,
          "readOnly": true
        },
        {
          "type": "null"
        }
      ]
    },
    "has_operating_cost": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1,
          "readOnly": true
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "writeOnly": true
    },
    "qty": {
      "type": [
        "number",
        "null"
      ],
      "readOnly": true,
      "writeOnly": true
    },
    "operating_component": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "writeOnly": true
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Stock"
}