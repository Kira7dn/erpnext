{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/ItemTaxWrite.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "item_tax_template": {
      "type": "string",
      "x-frappe-target-doctype": "Item Tax Template"
    },
    "tax_category": {
      "type": "string",
      "x-frappe-target-doctype": "Tax Category"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "maximum_net_rate": {
      "type": "number"
    },
    "minimum_net_rate": {
      "type": "number"
    },
    "custom_letron_orchestration_id": {
      "type": "string"
    },
    "custom_lark_approval_status": {
      "type": "string"
    }
  },
  "required": [
    "item_tax_template"
  ],
  "additionalProperties": false,
  "x-module": "Stock"
}