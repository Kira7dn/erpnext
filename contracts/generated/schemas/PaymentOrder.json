{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/PaymentOrder.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "naming_series": {
      "type": "string",
      "enum": [
        "PMO-"
      ]
    },
    "company": {
      "type": "string",
      "x-frappe-target-doctype": "Company"
    },
    "party": {
      "type": "string",
      "x-frappe-target-doctype": "Supplier"
    },
    "column_break_2": {
      "type": "string"
    },
    "posting_date": {
      "type": "string",
      "format": "date"
    },
    "section_break_5": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "PaymentOrderReference.json"
      }
    },
    "amended_from": {
      "type": "string",
      "x-frappe-target-doctype": "Payment Order",
      "readOnly": true
    },
    "payment_order_type": {
      "type": "string",
      "enum": [
        "Payment Request",
        "Payment Entry"
      ],
      "readOnly": true
    },
    "company_bank_account": {
      "type": "string",
      "x-frappe-target-doctype": "Bank Account"
    },
    "company_bank": {
      "type": "string",
      "x-frappe-target-doctype": "Bank"
    },
    "account": {
      "type": "string"
    }
  },
  "required": [
    "company",
    "company_bank_account",
    "name",
    "naming_series",
    "payment_order_type",
    "references"
  ],
  "additionalProperties": true,
  "x-module": "Accounts"
}