{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/BankTransaction.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "naming_series": {
      "type": "string",
      "enum": [
        "ACC-BTN-.YYYY.-"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "column_break_2": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Settled",
        "Unreconciled",
        "Reconciled",
        "Cancelled"
      ]
    },
    "bank_account": {
      "type": "string",
      "x-frappe-target-doctype": "Bank Account"
    },
    "company": {
      "type": "string",
      "x-frappe-target-doctype": "Company",
      "readOnly": true
    },
    "section_break_4": {
      "type": "string"
    },
    "column_break_7": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "x-frappe-target-doctype": "Currency"
    },
    "section_break_10": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "section_break_14": {
      "type": "string"
    },
    "reference_number": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string",
      "readOnly": true
    },
    "payment_entries": {
      "type": "array",
      "items": {
        "$ref": "BankTransactionPayments.json"
      }
    },
    "section_break_18": {
      "type": "string"
    },
    "allocated_amount": {
      "type": "number",
      "x-frappe-options": "currency",
      "readOnly": true
    },
    "amended_from": {
      "type": "string",
      "x-frappe-target-doctype": "Bank Transaction",
      "readOnly": true
    },
    "column_break_17": {
      "type": "string"
    },
    "unallocated_amount": {
      "type": "number",
      "x-frappe-options": "currency",
      "readOnly": true
    },
    "party_section": {
      "type": "string"
    },
    "party_type": {
      "type": "string",
      "x-frappe-target-doctype": "DocType"
    },
    "party": {
      "type": "string",
      "x-frappe-options": "party_type"
    },
    "deposit": {
      "type": "number",
      "x-frappe-options": "currency"
    },
    "withdrawal": {
      "type": "number",
      "x-frappe-options": "currency"
    },
    "column_break_10": {
      "type": "string"
    },
    "transaction_type": {
      "type": "string"
    },
    "column_break_3czf": {
      "type": "string"
    },
    "bank_party_name": {
      "type": "string"
    },
    "bank_party_iban": {
      "type": "string",
      "x-frappe-options": "IBAN"
    },
    "bank_party_account_number": {
      "type": "string"
    },
    "column_break_oufv": {
      "type": "string"
    },
    "extended_bank_statement_section": {
      "type": "string"
    },
    "included_fee": {
      "type": "number",
      "x-frappe-options": "currency"
    },
    "excluded_fee": {
      "type": "number",
      "x-frappe-options": "currency"
    },
    "is_rule_evaluated": {
      "type": "boolean",
      "readOnly": true
    },
    "matched_transaction_rule": {
      "type": "string",
      "x-frappe-target-doctype": "Bank Transaction Rule",
      "readOnly": true
    }
  },
  "required": [
    "name",
    "naming_series"
  ],
  "additionalProperties": true,
  "x-module": "Accounts"
}