{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/AssetCategoryWrite.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "asset_category_name": {
      "type": "string"
    },
    "column_break_3": {
      "type": "string"
    },
    "finance_book_detail": {
      "type": "string"
    },
    "finance_books": {
      "type": "array",
      "items": {
        "$ref": "AssetFinanceBookWrite.json"
      }
    },
    "section_break_2": {
      "type": "string"
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "AssetCategoryAccountWrite.json"
      }
    },
    "depreciation_options": {
      "type": "string"
    },
    "enable_cwip_accounting": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "non_depreciable_category": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "custom_letron_orchestration_id": {
      "type": "string"
    },
    "custom_lark_approval_status": {
      "type": "string"
    }
  },
  "required": [
    "accounts",
    "asset_category_name"
  ],
  "additionalProperties": false,
  "x-module": "Assets"
}