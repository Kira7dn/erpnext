{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/LandedCostVoucherWrite.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "naming_series": {
      "type": "string"
    },
    "company": {
      "type": "string",
      "x-frappe-target-doctype": "Company"
    },
    "purchase_receipts": {
      "type": "array",
      "items": {
        "$ref": "LandedCostPurchaseReceiptWrite.json"
      }
    },
    "purchase_receipt_items": {
      "type": "string"
    },
    "get_items_from_purchase_receipts": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "LandedCostItemWrite.json"
      }
    },
    "sec_break1": {
      "type": "string"
    },
    "taxes": {
      "type": "array",
      "items": {
        "$ref": "LandedCostTaxesandChargesWrite.json"
      }
    },
    "section_break_9": {
      "type": "string"
    },
    "col_break1": {
      "type": "string"
    },
    "distribute_charges_based_on": {
      "type": "string",
      "enum": [
        "Qty",
        "Amount",
        "Distribute Manually"
      ]
    },
    "sec_break2": {
      "type": "string"
    },
    "landed_cost_help": {
      "type": "string"
    },
    "column_break_2": {
      "type": "string"
    },
    "posting_date": {
      "type": "string",
      "format": "date"
    },
    "section_break_5": {
      "type": "string"
    },
    "vendor_invoices": {
      "type": "array",
      "items": {
        "$ref": "LandedCostVendorInvoiceWrite.json"
      }
    },
    "custom_letron_orchestration_id": {
      "type": "string"
    },
    "custom_lark_approval_status": {
      "type": "string"
    }
  },
  "required": [
    "company",
    "distribute_charges_based_on",
    "items",
    "naming_series",
    "posting_date",
    "purchase_receipts",
    "taxes"
  ],
  "additionalProperties": false,
  "x-module": "Stock"
}