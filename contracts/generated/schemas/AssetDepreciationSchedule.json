{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/AssetDepreciationSchedule.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "asset": {
      "type": "string",
      "x-frappe-target-doctype": "Asset"
    },
    "naming_series": {
      "type": "string",
      "enum": [
        "ACC-ADS-.YYYY.-"
      ]
    },
    "amended_from": {
      "type": "string",
      "x-frappe-target-doctype": "Asset Depreciation Schedule",
      "readOnly": true
    },
    "column_break_2": {
      "type": "string"
    },
    "depreciation_details_section": {
      "type": "string"
    },
    "finance_book": {
      "type": "string",
      "x-frappe-target-doctype": "Finance Book"
    },
    "depreciation_method": {
      "type": "string",
      "enum": [
        "Straight Line",
        "Double Declining Balance",
        "Written Down Value",
        "Manual"
      ],
      "readOnly": true
    },
    "rate_of_depreciation": {
      "type": "number",
      "readOnly": true
    },
    "column_break_8": {
      "type": "string"
    },
    "total_number_of_depreciations": {
      "type": "integer",
      "readOnly": true
    },
    "depreciation_schedule_section": {
      "type": "string"
    },
    "depreciation_schedule": {
      "type": "array",
      "items": {
        "$ref": "DepreciationSchedule.json"
      }
    },
    "details_section": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "readOnly": true
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Cancelled"
      ],
      "readOnly": true,
      "writeOnly": true
    },
    "frequency_of_depreciation": {
      "type": "integer",
      "readOnly": true
    },
    "expected_value_after_useful_life": {
      "type": "number",
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true
    },
    "finance_book_id": {
      "type": "integer",
      "readOnly": true,
      "writeOnly": true
    },
    "opening_accumulated_depreciation": {
      "type": "number",
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true,
      "writeOnly": true
    },
    "opening_number_of_booked_depreciations": {
      "type": "integer",
      "readOnly": true,
      "writeOnly": true
    },
    "daily_prorata_based": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1,
      "readOnly": true
    },
    "shift_based": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1,
      "readOnly": true
    },
    "company": {
      "type": "string",
      "x-frappe-target-doctype": "Company",
      "readOnly": true
    },
    "value_after_depreciation": {
      "type": "number",
      "readOnly": true
    },
    "net_purchase_amount": {
      "type": "number",
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true,
      "writeOnly": true
    }
  },
  "required": [
    "asset",
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Assets"
}