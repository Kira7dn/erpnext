{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/SalesInvoicePaymentResponse.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode_of_payment": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Mode of Payment"
    },
    "amount": {
      "type": [
        "number",
        "null"
      ],
      "x-frappe-options": "currency"
    },
    "column_break_3": {
      "type": [
        "string",
        "null"
      ]
    },
    "account": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Account",
      "readOnly": true
    },
    "type": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_amount": {
      "type": [
        "number",
        "null"
      ],
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true
    },
    "clearance_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "readOnly": true
    },
    "default": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1,
          "readOnly": true,
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_no": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Accounts"
}