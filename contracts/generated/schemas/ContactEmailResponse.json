{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/ContactEmailResponse.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email_id": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-options": "Email"
    },
    "is_primary": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Contacts"
}