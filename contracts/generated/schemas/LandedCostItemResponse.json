{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/LandedCostItemResponse.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "item_code": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Item",
      "readOnly": true
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true
    },
    "receipt_document_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Purchase Invoice",
        "Purchase Receipt",
        "Stock Entry",
        "Subcontracting Receipt",
        "",
        null
      ],
      "readOnly": true
    },
    "receipt_document": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-options": "receipt_document_type",
      "readOnly": true
    },
    "col_break2": {
      "type": [
        "string",
        "null"
      ]
    },
    "qty": {
      "type": [
        "number",
        "null"
      ],
      "readOnly": true
    },
    "rate": {
      "type": [
        "number",
        "null"
      ],
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true
    },
    "amount": {
      "type": [
        "number",
        "null"
      ],
      "x-frappe-options": "Company:company:default_currency",
      "readOnly": true
    },
    "applicable_charges": {
      "type": [
        "number",
        "null"
      ],
      "x-frappe-options": "Company:company:default_currency"
    },
    "purchase_receipt_item": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true,
      "writeOnly": true
    },
    "cost_center": {
      "type": [
        "string",
        "null"
      ],
      "x-frappe-target-doctype": "Cost Center"
    },
    "accounting_dimensions_section": {
      "type": [
        "string",
        "null"
      ]
    },
    "dimension_col_break": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_fixed_asset": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "integer"
          ],
          "minimum": 0,
          "maximum": 1,
          "readOnly": true,
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ]
    },
    "stock_entry_item": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Stock"
}