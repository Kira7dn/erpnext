{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/CustomerCreditLimit.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "credit_limit": {
      "type": "number"
    },
    "overdue_billing_threshold": {
      "type": "number",
      "writeOnly": true
    },
    "column_break_2": {
      "type": "string"
    },
    "company": {
      "type": "string",
      "x-frappe-target-doctype": "Company"
    },
    "bypass_credit_limit_check": {
      "type": [
        "boolean",
        "integer"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "x-module": "Selling"
}