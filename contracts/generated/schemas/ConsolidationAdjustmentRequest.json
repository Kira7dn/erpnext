{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letron.local/schemas/ConsolidationAdjustmentRequest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companies",
    "from_date",
    "to_date",
    "posting_date",
    "run_id"
  ],
  "properties": {
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "from_date": {
      "type": "string",
      "format": "date"
    },
    "to_date": {
      "type": "string",
      "format": "date"
    },
    "posting_date": {
      "type": "string",
      "format": "date"
    },
    "run_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.-]+$"
    }
  }
}