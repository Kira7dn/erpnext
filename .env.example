# Core database, mail and ERP delivery
LETRON_BOOTSTRAP_PASSWORD=change-me

# Lark application and Purchase Order approval
LARK_APP_ID=cli_replace-with-lark-app-id
LARK_APP_SECRET=replace-with-lark-app-secret
LARK_ALLOWED_TENANT_KEY=replace-with-tenant-key

# Internal service endpoints and API authentication

FRAPPE_ERP_NEXT_URL=http://localhost:8080
LETRON_ERP_APP_BASE_URL=http://localhost:3001
LETRON_AUTH_BASE_URL=http://localhost:3000
LETRON_INTERNAL_API_SECRET=replace-with-at-least-32-characters
DATABASE_URL=postgresql://user:password@localhost:5432/letron

# AWS and S3 backup
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET_NAME=letron-erp-backups

# Optional external tunnel
LARK_BOT_PUBLIC_URL=https://your-public-domain.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token

# Upstash session and orchestration storage
KV_REST_API_TOKEN=replace-with-upstash-token
KV_REST_API_URL=https://replace-with-upstash-endpoint.upstash.io

# Auth crypto and OIDC
AUTH_DATA_ENCRYPTION_KEY=replace-with-generated-key
OIDC_COOKIE_KEYS=["replace-with-cookie-key"]
OIDC_JWKS={"keys":[]}

#AI Provider
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENCLAW_LARK_APP_ID=replace-with-openclaw-lark-app-id
OPENCLAW_LARK_APP_SECRET=replace-with-openclaw-lark-app-secret
OPENCLAW_LARK_GROUP_ID=replace-with-lark-group-id
OPENCLAW_GATEWAY_TOKEN=replace-with-local-gateway-token
