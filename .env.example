# Copy to .env on the compute. Never commit the populated .env file.
DB_ROOT_PASSWORD=change-me
ADMIN_PASSWORD=change-me
SMTP_PASSWORD=change-me
LETRON_WEBHOOK_SECRET=change-me
LETRON_REALTIME_TOKEN=change-me

# Auth Server OIDC client used by ERPNext. Run the provisioning command in
# apps/auth-server to generate the real client secret in the ignored .env.
LETRON_SSO_ISSUER=https://auth.example.com/api/oidc
LETRON_SSO_INTERNAL_ISSUER=https://auth.example.com/api/oidc
LETRON_SSO_CLIENT_ID=letron-erp
LETRON_SSO_CLIENT_SECRET=change-me-at-least-32-characters
LETRON_SSO_ERP_BASE_URL=https://erp.example.com

# Lark User Group -> ERPNext role synchronization. Keep disabled until the
# Lark app has contact:group:readonly and the real group IDs are configured.
LETRON_SSO_ROLE_SYNC_ENABLED=false
LETRON_SSO_REQUIRED_LARK_GROUP_ID=replace-erp-access-group-id
LETRON_SSO_SYNC_URL=https://auth.example.com/api/internal/lark-role-snapshots
LETRON_SSO_SYNC_SECRET=change-me-at-least-32-characters
LETRON_SSO_REQUEST_CHECK_INTERVAL_SECONDS=60
LETRON_SSO_SNAPSHOT_MAX_AGE_SECONDS=120
LETRON_SSO_STALE_LOCK_SECONDS=600
LETRON_SSO_BREAK_GLASS_MAX_SECONDS=3600

# Global Access Policy admin. The existing SSO ERP base URL and sync secret are
# reused for the internal gateway and policy publication.
GLOBAL_ACCESS_ADMIN_GROUP_ID=replace-global-access-admin-group-id
